<Window x:Class="SurfLyrics.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SurfLyrics 설정" Width="470" Height="740" ResizeMode="NoResize"
 Background="#18292C" WindowStartupLocation="CenterOwner" Icon="Assets/SurfLyrics.ico">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
  <TextBlock Text="설정" FontSize="26" FontWeight="SemiBold" />
  <TextBlock Text="가사 소스" FontSize="15" Foreground="{StaticResource Accent}" Margin="0,26,0,5" />
  <TextBlock Text="켜진 소스를 위에서부터 차례로 확인합니다." FontSize="12" Foreground="#8FA9A7" Margin="0,0,0,6" />
  <CheckBox x:Name="SpotifySource" Content="Spotify 클라이언트" />
  <CheckBox x:Name="LrclibSource" Content="LRCLIB" />
  <CheckBox x:Name="MusixmatchSource" Content="Musixmatch" />
  <Button x:Name="ConnectButton" Content="Spotify 다시 시작하여 가사 연결" Click="ConnectSpotify" HorizontalAlignment="Left" Margin="0,8,0,4" />
  <CheckBox x:Name="AutoConnect" Content="연결이 끊기면 Spotify 자동 재연결" />
  <TextBlock Text="자동 재연결을 켜면 Spotify가 다시 시작될 수 있습니다.&#10;재생 상태는 Spotify의 설정에 따라 달라질 수 있습니다." FontSize="11" Foreground="#8FA9A7" TextWrapping="Wrap" />
  <TextBlock x:Name="ConnectionStatus" Text="Spotify 연결을 준비하지 않아도 다른 가사 소스를 사용할 수 있습니다." FontSize="11" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0" />
  <TextBlock Text="표시" FontSize="15" Foreground="{StaticResource Accent}" Margin="0,24,0,5" />
  <CheckBox x:Name="TaskbarDisplay" Content="작업 표시줄 오른쪽에 가사 표시" />
  <TextBlock x:Name="TaskbarFontLabel" Text="작업 표시줄 글자 크기" FontSize="12" Margin="0,10,0,8" />
  <Slider x:Name="TaskbarFontSlider" Minimum="10" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" />
  <CheckBox x:Name="OnTop" Content="가사 창을 항상 위에 표시" />
  <TextBlock x:Name="FontLabel" Text="보조 가사 창 글자 크기" FontSize="12" Margin="0,10,0,8" />
  <Slider x:Name="FontSlider" Minimum="18" Maximum="44" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" />
  <TextBlock x:Name="OffsetLabel" Text="가사 시간 조정" FontSize="12" Margin="0,16,0,8" />
  <Slider x:Name="OffsetSlider" Minimum="-5000" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" />
  <TextBlock Text="양수는 가사를 일찍, 음수는 늦게 표시합니다." FontSize="11" Foreground="#8FA9A7" Margin="0,6,0,0" />
  <CheckBox x:Name="StartAtLogin" Content="Windows 로그인 시 실행" Margin="0,20,0,0" />
  <Button Content="저장" Click="Save" HorizontalAlignment="Right" Margin="0,20,0,0" MinWidth="86" />
 </StackPanel></ScrollViewer>
</Window>
