<Window x:Class="SurfLyrics.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SurfLyrics" Width="620" Height="300" MinWidth="440" MinHeight="260"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
 Icon="Assets/SurfLyrics.ico" MouseLeftButtonDown="DragWindow" Closing="WindowClosing">
 <Border Background="#F218292C" BorderBrush="#395355" BorderThickness="1" CornerRadius="18" Padding="24,18,24,18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="Assets/SurfLyrics.png" Width="30" Height="30" Margin="0,0,10,0" />
     <TextBlock Text="SurfLyrics" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
     <Border Background="#244442" CornerRadius="5" Margin="12,0,0,0" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="WINDOWS" FontSize="9" Foreground="{StaticResource Accent}" /></Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="PinButton" Content="고정" ToolTip="항상 위에 표시" Click="TogglePin" Padding="9,6" Margin="0,0,6,0" />
     <Button Content="설정" Click="OpenSettings" Padding="9,6" Margin="0,0,6,0" />
     <Button Content="—" ToolTip="트레이로 숨기기" AutomationProperties.Name="트레이로 숨기기" Click="HideWindow" Padding="9,6" />
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,22,0,20">
    <TextBlock x:Name="LyricText" Text="♫" Foreground="{StaticResource Accent}" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
    <TextBlock x:Name="NextText" Text="Spotify 또는 Apple Music에서 음악을 재생해 주세요" Foreground="#8FA9A7" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
   </StackPanel>
   <Grid Grid.Row="2" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TrackText" Text="음악을 기다리는 중" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     <TextBlock x:Name="SourceText" Text="동기화 가사 · Spotify / LRCLIB / Musixmatch" FontSize="11" Foreground="#8FA9A7" Margin="0,5,10,0" /></StackPanel>
    <Button x:Name="PlaybackButton" Grid.Column="1" Content="재생" IsEnabled="False" Click="TogglePlayback" Padding="12,7" VerticalAlignment="Center" />
   </Grid>
   <ProgressBar x:Name="TrackProgress" Grid.Row="3" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}" Background="#304749" BorderThickness="0" />
  </Grid>
 </Border>
</Window>
